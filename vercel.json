{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo nothing to install",
  "buildCommand": "bash tools/demo-page/vercel-build.sh",
  "outputDirectory": "public",
  "headers": [
    { "source": "/engine/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sounds/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/BUILD.txt", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
