<Project Sdk="Microsoft.NET.Sdk">
  <!-- Records a running MatchEngine as replay data (frames, events, stats). Used by the SimRunner (replay files), and by the
       browser build (the engine running live in the demo page), so both produce exactly the same data. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SoccerVision.Replay</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SoccerVision.Simulation/SoccerVision.Simulation.csproj" />
  </ItemGroup>
</Project>
